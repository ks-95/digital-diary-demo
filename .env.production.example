# Copy to .env.production on the server. Replace every example value.
API_DOMAIN=api.your-domain.example
ENVIRONMENT=production

# Supabase Dashboard > Connect > Session pooler is suitable for an IPv4-only VM.
# Keep the Supabase-issued host and username; URL-encode reserved password chars.
DB_CONNECTION=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DB_SSL=true
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
AUTO_INIT_DB=false

CORS_ORIGINS=https://app.your-domain.example
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=SERVER_ONLY_SB_SECRET_KEY
SUPABASE_STORAGE_BUCKET=case-files

AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Razorpay keys and plan ID are added after the monthly launch price is finalized.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_TOTAL_COUNT=120
BILLING_ENFORCED=false
