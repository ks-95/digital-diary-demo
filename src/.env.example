# Copy to the host's secret manager or src/.env for local development.
# Never commit real credentials. For Supabase, select a connection string in
# Dashboard > Connect and use direct IPv6 or the shared SESSION pooler on IPv4.
ENVIRONMENT=production
DB_CONNECTION=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DB_SSL=true
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
AUTO_INIT_DB=false

# Exact web origins only; native Android/iOS apps do not use browser CORS.
CORS_ORIGINS=https://app.example.com
JWT_SECRET_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Set a private bucket named case-files in Supabase Storage.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=SERVER_ONLY_SB_SECRET_KEY
SUPABASE_STORAGE_BUCKET=case-files

# Gemini primary with OpenAI fallback on transient provider-capacity failures.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Razorpay subscription integration. Create a monthly plan in Razorpay and put
# its plan ID here; the INR amount is managed in Razorpay, not hard-coded here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_TOTAL_COUNT=120
BILLING_ENFORCED=false
